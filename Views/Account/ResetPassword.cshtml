@model Event_Management_System.Models.ResetPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Reset Password | MCC</title>
    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>

<div class="background"></div>

<div class="container">
    <div class="glass-card">
        <div class="logo">
            <img src="~/images/logo.png" alt="Logo">
            <h2>Reset Password</h2>
            <p>Enter your new password below.</p>
        </div>

        <form asp-action="ResetPassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            
            <input asp-for="Token" type="hidden">
            <input asp-for="Email" type="hidden">

            <div asp-validation-summary="ModelOnly" class="text-danger" style="background: rgba(220,53,69,0.1); padding: 10px; border-radius: 8px; margin-bottom: 15px; color: #dc3545; font-size: 0.9rem;"></div>

            <div class="password">
                <input asp-for="NewPassword" type="password" id="newPassword" maxlength="15" placeholder="New Password" required>
                <i class="fa fa-eye" onclick="togglePassword(this)"></i>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger" style="display: block; margin-top: 0px; margin-bottom: 15px; font-size: 0.85rem; color: #dc3545;"></span>

            <!-- Password Strength Indicator -->
            <div class="password-strength-container">
                <div class="strength-bar">
                    <div class="strength-bar-fill" id="strengthBar"></div>
                </div>
                <div class="strength-text-container">
                    <span>Password strength:</span>
                    <span class="strength-text" id="strengthText">Weak</span>
                </div>
            </div>

            <div class="password">
                <input asp-for="ConfirmPassword" type="password" id="confirmPassword" maxlength="15" placeholder="Confirm Password" required>
                <i class="fa fa-eye" onclick="togglePassword(this)"></i>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger" style="display: block; margin-top: 0px; margin-bottom: 15px; font-size: 0.85rem; color: #dc3545;"></span>

            <button type="submit" class="btn-primary">Reset Password</button>
        </form>

        <p class="switch">
            Remember your password?
            <a href="@Url.Action("Login", "Account")">Login</a>
        </p>
    </div>
</div>

<script src="~/js/auth.js"></script>
<script src="~/js/password-strength.js"></script>
<script>
    // Initialize password strength indicator
    const passwordInput = document.getElementById('newPassword');
    if (passwordInput) {
        passwordInput.addEventListener('input', function() {
            updatePasswordStrength(this.value);
        });
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
