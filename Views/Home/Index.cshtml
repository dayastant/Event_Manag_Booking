<!-- Upcoming Events Section -->
<section class="events">
    <div class="container">
        <div class="section-header">
            <h2>Upcoming Events</h2>
            <p>What's on the time is quite special. <br/>All are limited-capacity and will sell out fast so grab tickets while you can!</p>
        </div>
        
        <div class="events-grid">
            @foreach (var evt in Model.Take(3))
            {
                <div class="event-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="event-badge" style="margin:0;">@evt.Category</span>
                        <span class="status-badge-user @evt.Status.ToLower()">@evt.Status</span>
                    </div>
                    <h3>@evt.EventName</h3>
                    <p class="event-desc">@(evt.Description?.Length > 120 ? evt.Description.Substring(0, 120) + "..." : evt.Description ?? "Experience an amazing event with great performances and unforgettable moments.")</p>
                    <div class="event-meta">
                        <div class="event-location">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>@(evt.Venue?.VenueName ?? "TBA")</span>
                        </div>
                        <div class="event-datetime">
                            <div>
                                <i class="far fa-calendar"></i>
                                <span>@evt.EventDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div>
                                <i class="far fa-clock"></i>
                                <span>@DateTime.Today.Add(evt.StartTime).ToString("hh:mm tt")</span>
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("Details", "Events", new { id = evt.EventID })" class="event-btn">View Details</a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="services">
    <div class="container">
        <div class="section-header">
            <h2>Our Services</h2>
            <p>Everything you need for a seamless event booking experience</p>
        </div>
        <div class="services-grid">
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <h3>Easy Booking</h3>
                <p>Quick and simple online ticket booking with instant confirmation</p>
            </div>
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3>Secure Payments</h3>
                <p>Industry-standard encryption for safe transactions</p>
            </div>
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-qrcode"></i>
                </div>
                <h3>QR E-Tickets</h3>
                <p>Digital tickets with QR codes for contactless entry</p>
            </div>
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-headset"></i>
                </div>
                <h3>24/7 Support</h3>
                <p>Round-the-clock customer assistance whenever you need</p>
            </div>
        </div>
    </div>
</section>

