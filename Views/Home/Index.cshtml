@model List<Event_Management_System.Models.Event>
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="~/css/testimonials.css" />

<!-- Hero Section -->
<section class="hero">
    <div class="hero-container">
        <div class="hero-left">
            <h1 class="hero-title">
                Discover<br>
                unforgettable<br>
                experiences with<br> <span style="color: #0b1b3a; font-weight: semi-bold;">"CulturaPass."</span>
            </h1>
            <p class="hero-subtitle">
                Book tickets for concerts, workshops, exhibitions and cultural events. 
                Experience the best of entertainment in your metropolitan area.
            </p>
            <a href="@Url.Action("Index", "Events")" class="btn-dark">Explore Now</a>
        </div>
        <div class="hero-right">
            <!-- Main Backdrop Image -->
            <div class="hero-main-visual">
                <img src="~/images/hero_event.jpg" alt="Concert Crowd" class="main-backdrop-img" onerror="this.src='/images/pic-05.jpg'">
                
                @{
                    var floatingEventsData = ViewBag.FloatingEvents as List<Event_Management_System.Models.Event> ?? new List<Event_Management_System.Models.Event>();
                    var floatingEvent1 = floatingEventsData.ElementAtOrDefault(0);
                    var floatingEvent2 = floatingEventsData.ElementAtOrDefault(1);
                }

                @if (floatingEvent1 != null)
                {
                    <!-- Floating Card 1 (Left Overlap) -->
                    <a href="@Url.Action("Details", "Events", new { id = floatingEvent1.EventID })" class="hero-float-card card-left" style="text-decoration: none;">
                        <div class="float-img-wrapper">
                            <img src="@(floatingEvent1.EventImageBase64 ?? Url.Content("~/images/pic-01.jpg"))" alt="@floatingEvent1.EventName" onerror="this.src='/images/pic-01.jpg'">
                        </div>
                        <div class="float-content">
                            <span class="float-badge">@floatingEvent1.Category</span>
                            <h5>@floatingEvent1.EventName</h5>
                            <p class="float-time">@DateTime.Today.Add(floatingEvent1.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(floatingEvent1.EndTime).ToString("hh:mm tt")</p>
                            <span class="float-btn">Get Tickets</span>
                        </div>
                    </a>
                }

                @if (floatingEvent2 != null)
                {
                    <!-- Floating Card 2 (Top Right) -->
                    <a href="@Url.Action("Details", "Events", new { id = floatingEvent2.EventID })" class="hero-float-card card-right" style="text-decoration: none;">
                        <div class="float-img-wrapper">
                            <img src="@(floatingEvent2.EventImageBase64 ?? Url.Content("~/images/pic-02.jpg"))" alt="@floatingEvent2.EventName" onerror="this.src='/images/pic-02.jpg'">
                        </div>
                        <div class="float-content">
                            <span class="float-badge">@floatingEvent2.Category</span>
                            <h5>@floatingEvent2.EventName</h5>
                            <p class="float-time">@DateTime.Today.Add(floatingEvent2.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(floatingEvent2.EndTime).ToString("hh:mm tt")</p>
                            <span class="float-btn">Get Tickets</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

