@{
    ViewData["Title"] = "Contact Us";
}

<link rel="stylesheet" href="~/css/contact.css" />

<section class="hero">
    <div class="container">
        <h1>Get in Touch</h1>
        <p>Have questions? We'd love to hear from you. Send us a message and we'll respond as soon as possible.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row">
            <!-- Left Column: Contact Information -->
            <div class="col-6">
                <div class="card mb-4">
                    <div class="card-body">
                        <h3>Contact Information</h3>
                        <p class="text-secondary">
                            Feel free to get in touch with your queries or contact us for more details.
                        </p>

                        <div class="info-item">
                            <div class="info-icon email-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="info-content">
                                <strong>Email</strong>
                                <p class="text-secondary">
                                    <a href="mailto:info@calturpass.com" style="color: inherit; text-decoration: none;">info@culturapass.com</a><br>
                                    Respond within 24 hours
                                </p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon phone-icon">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div class="info-content">
                                <strong>Phone</strong>
                                <p class="text-secondary">
                                    <a href="tel:+441234567890" style="color: inherit; text-decoration: none;">+44 (123) 456-7890</a><br>
                                    24/7 Immediate Assistance
                                </p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon location-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="info-content">
                                <strong>Location</strong>
                                <p class="text-secondary">
                                    <a href="https://maps.google.com/?q=166-220+Holloway+Road+London+N7+8BQ" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">166-220 Holloway Road<br>
                                    London, N7 8BQ</a>
                                </p>
                            </div>
                        </div>

                        <div class="social-section">
                            <h5>Follow Us</h5>
                            <div class="social-links">
                                <a href="https://youtube.com/@@culturapass" target="_blank" rel="noopener noreferrer" class="social-link">
                                    <i class="fab fa-youtube" style="color: #FF0000;"></i>
                                </a>
                                <a href="https://facebook.com/culturapass" target="_blank" rel="noopener noreferrer" class="social-link">
                                    <i class="fab fa-facebook" style="color: #1877F2;"></i>
                                </a>
                                <a href="https://wa.me/11234567890" target="_blank" rel="noopener noreferrer" class="social-link">
                                    <i class="fab fa-whatsapp" style="color: #25D366;"></i>
                                </a>
                                <a href="https://instagram.com/culturapass" target="_blank" rel="noopener noreferrer" class="social-link">
                                    <i class="fab fa-instagram" style="color: #E4405F;"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Contact Form -->
            <div class="col-6">
                <div class="card form-card">
                    <div class="card-header">
                        <h3>Send us a Message</h3>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Home" asp-action="Contact" method="post">
                            @Html.AntiForgeryToken()
                            
                            <div class="form-group">
                                <label class="form-label">Full Name*</label>
                                <input type="text" name="name" class="form-control" placeholder="Enter your full name" required>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Email Address*</label>
                                <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Message*</label>
                                <textarea name="message" class="form-control" rows="6" placeholder="Please describe your inquiry or message in detail..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg btn-block">
                                <i class="fas fa-paper-plane"></i> Send Message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- FAQ Section -->
        <div class="faq-section">
            <h2>Frequently Asked Questions</h2>
            <div class="faq-grid">
                <div class="card faq-card">
                    <div class="card-body">
                        <h5>How do I book a ticket for an event?</h5>
                        <p class="text-secondary">
                            You can book tickets through our online booking system. Select your preferred event, date, and time, then complete the booking form. You'll receive a confirmation via email.
                        </p>
                    </div>
                </div>
                <div class="card faq-card">
                    <div class="card-body">
                        <h5>Can I cancel or modify my booking?</h5>
                        <p class="text-secondary">
                            Yes, you can cancel or modify your booking up to 24 hours before the event. Please contact our support team or use your account dashboard to make changes.
                        </p>
                    </div>
                </div>
                <div class="card faq-card">
                    <div class="card-body">
                        <h5>What payment methods do you accept?</h5>
                        <p class="text-secondary">
                            We accept all major credit cards, debit cards, and digital payment methods including PayPal, Apple Pay, and Google Pay for your convenience.
                        </p>
                    </div>
                </div>
                <div class="card faq-card">
                    <div class="card-body">
                        <h5>How do I receive my tickets?</h5>
                        <p class="text-secondary">
                            After successful booking, you'll receive e-tickets via email with a QR code. You can also access and download your tickets from your account dashboard at any time.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Display pop-up notifications based on TempData using global popup system
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["Success"] != null)
            {
                <text>
                globalPopup.alert({
                    title: 'Success!',
                    message: '@TempData["Success"]',
                    icon: 'fa-check-circle',
                    iconType: 'info',
                    buttonText: 'OK'
                });
                </text>
            }
            
            @if (TempData["Error"] != null)
            {
                <text>
                globalPopup.alert({
                    title: 'Error',
                    message: '@TempData["Error"]',
                    icon: 'fa-exclamation-circle',
                    iconType: 'danger',
                    buttonText: 'OK'
                });
                </text>
            }
        });
    </script>
}

