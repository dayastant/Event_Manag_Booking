@model List<Event_Management_System.Models.Inquiry>
@{
    ViewData["Title"] = "Inquiries Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-section">
    <div class="section-header">
        <div>
            <h2 class="section-title"><i class="fas fa-envelope-open-text"></i> Contact Inquiries</h2>
            <p class="text-muted mb-0">View and manage customer inquiries from the contact form</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="text-center">Date</th>
                        <th>Message Preview</th>
                        <th class="text-center">Sender Type</th>
                        <th class="text-center">Status</th>
                        <th class="text-center" style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inquiry in Model.OrderByDescending(i => i.InquiryDate))
                    {
                        <tr>
                            <td class="text-center">
                                <strong>@inquiry.InquiryDate.ToString("MMM dd, yyyy")</strong><br/>
                                <small class="text-muted">@inquiry.InquiryDate.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                <span class="text-muted">
                                    @(inquiry.Message.Length > 80 ? inquiry.Message.Substring(0, 80) + "..." : inquiry.Message)
                                </span>
                            </td>
                            <td class="text-center">
                                @if (inquiry.MemberID != null)
                                {
                                    <span class="status-badge member">
                                        <i class="fas fa-user"></i> Member
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge guest">
                                        <i class="fas fa-user-slash"></i> Guest
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (inquiry.Status == "Pending")
                                {
                                    <span class="status-badge pending">
                                        <i class="fas fa-clock"></i> @inquiry.Status
                                    </span>
                                }
                                else if (inquiry.Status == "Resolved")
                                {
                                    <span class="status-badge resolved">
                                        <i class="fas fa-check-circle"></i> @inquiry.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge default">@inquiry.Status</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button class="btn-edit btn-sm" onclick="viewInquiry(@inquiry.InquiryID, '@Html.Raw(inquiry.Message.Replace("'", "\\'").Replace("\n", "\\n"))', '@inquiry.InquiryDate.ToString("MMM dd, yyyy hh:mm tt")', '@(inquiry.MemberID != null ? "Member" : "Guest")', 'User', 'user@example.com')">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                    @if (inquiry.Status == "Pending")
                                    {
                                        <button class="btn-approve btn-sm" onclick="approveInquiry(@inquiry.InquiryID)">
                                            <i class="fas fa-check"></i> Approve
                                        </button>
                                    }
                                    else if (inquiry.Status == "Resolved")
                                    {
                                        <button class="btn-danger btn-sm" onclick="showDeleteModal(@inquiry.InquiryID)">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <p>No inquiries yet</p>
        </div>
    }
</div>

<!-- Inquiry Details Modal -->
<div id="inquiryModal" class="inquiry-modal">
    <div class="inquiry-modal-overlay" onclick="closeInquiryModal()"></div>
    <div class="inquiry-modal-content">
        <div class="inquiry-modal-header">
            <h3><i class="fas fa-envelope-open-text"></i> Inquiry Details</h3>
            <button class="modal-close-btn" onclick="closeInquiryModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="inquiry-modal-body">
            <div class="inquiry-info-grid">
                <div class="inquiry-info-item">
                    <label>Sender Name</label>
                    <p id="modalName"></p>
                </div>
                <div class="inquiry-info-item">
                    <label>Email</label>
                    <p id="modalEmail"></p>
                </div>
                <div class="inquiry-info-item">
                    <label>Sender Type</label>
                    <p id="modalSenderType"></p>
                </div>
                <div class="inquiry-info-item">
                    <label>Submitted Date</label>
                    <p id="modalDate"></p>
                </div>
            </div>

            <div class="inquiry-message">
                <label>Message</label>
                <p id="modalMessage"></p>
            </div>
        </div>
        <div class="inquiry-modal-footer">
            <a id="replyButton" href="" class="btn-primary">
                <i class="fas fa-reply"></i> Reply via Email
            </a>
            <button onclick="closeInquiryModal()" class="btn-secondary">
                Close
            </button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-icon">
            <i class="fas fa-trash-alt"></i>
        </div>
        <h3 class="modal-title">Delete Inquiry</h3>
        <p class="modal-text">Are you sure you want to delete this inquiry? This action cannot be undone.</p>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-confirm-delete" id="confirmDeleteBtn">Delete</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let deleteId = null;

        function viewInquiry(id, message, date, senderType, name, email) {
            document.getElementById('modalName').textContent = name;
            document.getElementById('modalEmail').innerHTML = '<a href="mailto:' + email + '">' + email + '</a>';
            document.getElementById('modalSenderType').innerHTML = senderType === 'Member' 
                ? '<span class="status-badge member"><i class="fas fa-user"></i> Member</span>'
                : '<span class="status-badge guest"><i class="fas fa-user-slash"></i> Guest</span>';
            document.getElementById('modalDate').textContent = date;
            document.getElementById('modalMessage').textContent = message;
            document.getElementById('replyButton').href = 'mailto:' + email + '?subject=Re: Your Inquiry';
            
            document.getElementById('inquiryModal').classList.add('active');
        }

        function closeInquiryModal() {
            document.getElementById('inquiryModal').classList.remove('active');
        }

        function approveInquiry(id) {
            // No confirmation logic as requested
            fetch('/Admin/ApproveInquiry/' + id, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error approving inquiry');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error approving inquiry');
            });
        }

        function showDeleteModal(id) {
            deleteId = id;
            document.getElementById('deleteModal').classList.add('active');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
            deleteId = null;
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (deleteId) {
                fetch('/Admin/DeleteInquiry/' + deleteId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error deleting inquiry');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error deleting inquiry');
                });
            }
        });

        // Close on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeInquiryModal();
                closeDeleteModal();
            }
        });
    </script>
}
