@model IEnumerable<Event_Management_System.Models.Venue>
@{
    ViewData["Title"] = "Manage Venues";
    Layout = "_AdminLayout";
}

<div class="content-section">
    <div class="section-header">
        <h2 class="section-title">All Venues</h2>
        <div class="section-actions">
            <a href="@Url.Action("CreateVenue")" class="btn-primary">
                <i class="fas fa-plus"></i>
                Add New Venue
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Venue Name</th>
                    <th>Location</th>
                    <th class="text-center">Capacity</th>
                    <th class="text-center" style="text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venue in Model)
                {
                    <tr>
                        <td><strong style="color: #0b1b3a;">@venue.VenueName</strong></td>
                        <td>@venue.Address, @venue.City</td>
                        <td class="text-center">@venue.Capacity</td>
                        <td class="text-center">
                            <div class="table-actions">
                                <a href="@Url.Action("EditVenue", new { id = venue.VenueID })" class="btn-edit btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <button type="button" class="btn-danger btn-sm" onclick="showDeleteModal('@Url.Action("DeleteVenue", new { id = venue.VenueID })')">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-building-slash"></i>
            <p>No venues found</p>
            <a href="@Url.Action("CreateVenue")" class="btn-primary">
                <i class="fas fa-plus"></i>
                Create First Venue
            </a>
        </div>
    }
</div>
