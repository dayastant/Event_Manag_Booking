@model Event_Management_System.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var member = Model.Member;
}

<link rel="stylesheet" href="~/css/dashboard-premium.css" />

<!-- Premium Stats Cards -->
<div class="premium-stats-grid dashboard-animated">
    <div class="premium-stat-card">
        <div class="premium-stat-icon primary">
            <i class="fas fa-ticket-alt"></i>
        </div>
        <div>
            <div class="premium-stat-value">@Model.TotalBookings</div>
            <div class="premium-stat-label">Total Bookings</div>
        </div>
    </div>
    <div class="premium-stat-card">
        <div class="premium-stat-icon success">
            <i class="fas fa-calendar-check"></i>
        </div>
        <div>
            <div class="premium-stat-value">@Model.UpcomingEvents</div>
            <div class="premium-stat-label">Upcoming Events</div>
        </div>
    </div>
    <div class="premium-stat-card">
        <div class="premium-stat-icon warning">
            <i class="fas fa-star"></i>
        </div>
        <div>
            <div class="premium-stat-value">@Model.TotalReviews</div>
            <div class="premium-stat-label">Reviews Written</div>
        </div>
    </div>
</div>

<!-- Recent Bookings -->
<div class="dashboard-premium-card dashboard-animated" style="animation-delay: 0.1s;">
    <h3>Recent Bookings</h3>
    @if (Model.RecentBookings != null && Model.RecentBookings.Any())
    {
        <div class="table-container">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Tickets</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.RecentBookings.Take(5))
                    {
                        <tr>
                            <td class="booking-reference">@booking.BookingReferenceNumber</td>
                            <td class="event-name">@booking.Event?.EventName</td>
                            <td>@booking.Event?.EventDate.ToString("MMM dd, yyyy")</td>
                            <td class="ticket-quantity">@booking.Quantity</td>
                            <td class="amount-value">£@booking.TotalAmount</td>
                            <td>
                                @if (booking.BookingStatus == "Confirmed")
                                {
                                    <span class="dashboard-badge badge-confirmed">
                                        <i class="fas fa-check-circle"></i> Confirmed
                                    </span>
                                }
                                else if (booking.BookingStatus == "Cancelled")
                                {
                                    <span class="dashboard-badge badge-cancelled">
                                        <i class="fas fa-times-circle"></i> Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="dashboard-badge badge-pending">
                                        <i class="fas fa-clock"></i> Pending
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-ticket-alt empty-state-icon"></i>
            <p class="empty-state-text">No bookings yet</p>
            <a href="@Url.Action("Index", "Events")" class="btn-premium-dashboard">
                <i class="fas fa-calendar-plus"></i> Browse Events
            </a>
        </div>
    }
</div>

<!-- Recent Reviews -->
<div class="dashboard-premium-card dashboard-animated" style="animation-delay: 0.2s;">
    <h3>Recent Reviews</h3>
    @if (Model.RecentReviews != null && Model.RecentReviews.Any())
    {
        <div class="row">
            @foreach (var review in Model.RecentReviews.Take(3))
            {
                <div class="col-4 mb-4" style="margin-bottom: 10px;">
                    <div class="review-card">
                        <div class="review-rating">
                            @for (int i = 0; i < (review.Rating ?? 0); i++)
                            {
                                <i class="fas fa-star"></i>
                            }
                        </div>
                        <h5 class="review-event-name">@review.Event?.EventName</h5>
                        @if (!string.IsNullOrEmpty(review.Title))
                        {
                            <p class="review-title">@review.Title</p>
                        }
                        <p class="review-comment">
                            @((review.Comment ?? "").Length > 100 ? (review.Comment ?? "").Substring(0, 100) + "..." : (review.Comment ?? ""))
                        </p>
                        <small class="review-date">@review.ReviewDate.ToString("MMM dd, yyyy")</small>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-star empty-state-icon"></i>
            <p class="empty-state-text">No reviews yet</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function deleteBooking(bookingId) {
            const confirmed = await globalPopup.confirm({
                title: 'Delete Booking',
                message: 'Are you sure you want to delete this booking? This action cannot be undone.',
                confirmText: 'Delete',
                cancelText: 'Cancel',
                danger: true
            });

            if (confirmed) {
                try {
                    const response = await fetch('@Url.Action("DeleteBooking", "Dashboard")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ bookingId: bookingId })
                    });

                    const data = await response.json();
                    
                    if (data.success) {
                        await globalPopup.alert({
                            title: 'Success',
                            message: 'Booking deleted successfully!',
                            icon: 'fa-check-circle',
                            iconType: 'success'
                        });
                        location.reload();
                    } else {
                        await globalPopup.alert({
                            title: 'Error',
                            message: data.message || 'Failed to delete booking.',
                            icon: 'fa-exclamation-circle',
                            iconType: 'danger'
                        });
                    }
                } catch (error) {
                    await globalPopup.alert({
                        title: 'Error',
                        message: 'An error occurred while deleting the booking.',
                        icon: 'fa-exclamation-circle',
                        iconType: 'danger'
                    });
                }
            }
        }
    </script>
}

