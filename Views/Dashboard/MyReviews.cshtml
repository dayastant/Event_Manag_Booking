@model List<Event_Management_System.Models.Review>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "My Reviews";
}

<link rel="stylesheet" href="~/css/dashboard-premium.css" />

<div>
    <h1 class="dashboard-page-title">My Reviews</h1>
    
    @Html.AntiForgeryToken()
    <div class="reviews-container">
        <div class="reviews-grid">
            @if (Model != null && Model.Any())
            {
                @foreach (var review in Model)
                {
                    <div class="dashboard-premium-card dashboard-animated review-item-card">
                        <div>
                            <div class="review-header">
                                <h4 class="review-event-title">@review.Event?.EventName</h4>
                                <div class="review-rating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= review.Rating ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                            </div>
                            <p class="review-comment-text">@review.Comment</p>
                        </div>
                        
                        <div class="review-footer">
                            <small class="review-date">@review.ReviewDate.ToString("MMM dd, yyyy")</small>
                            <div class="action-buttons-group">
                                <button onclick="openEditModal(@review.ReviewID, @(review.Rating ?? 5), '@System.Web.HttpUtility.JavaScriptStringEncode(review.Comment)')" class="dashboard-badge dashboard-badge-action badge-action-edit">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button onclick="confirmDelete(@review.ReviewID)" class="dashboard-badge dashboard-badge-action badge-action-delete">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-star empty-state-icon"></i>
                    <p class="empty-state-text">No reviews yet. <a href="@Url.Action("Index", "Events")" class="empty-state-link">Browse events</a> and share your experience!</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Review Modal -->
<div id="editReviewModal" class="premium-modal">
    <div class="premium-modal-content" style="text-align: left; max-width: 500px;">
        <div class="premium-modal-header" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <h2 class="premium-modal-title" style="margin: 0; font-size: 1.5rem; color: #0b1b3a;">Edit Review</h2>
            <button type="button" class="premium-modal-close" onclick="closeEditModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
        </div>
        <form id="editReviewForm" onsubmit="submitEditReview(event)">
            <input type="hidden" id="editReviewId">
            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #334155;">Rating</label>
                <select id="editRating" class="form-control" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem;">
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Very Good</option>
                    <option value="3">3 - Good</option>
                    <option value="2">2 - Fair</option>
                    <option value="1">1 - Poor</option>
                </select>
            </div>
            <div class="form-group" style="margin-bottom: 25px;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #334155;">Comment</label>
                <textarea id="editComment" class="form-control" rows="5" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; resize: vertical;"></textarea>
            </div>
            <div class="form-actions" style="margin-top: 20px; text-align: right; display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-premium-secondary" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn-premium-dashboard">Update Review</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal - Using Global Popup Logic instead of legacy modal for consistency -->
<div id="deleteModal" class="premium-modal" style="display: none;"> <!-- Hidden legacy -->
    <div class="premium-modal-content"></div>
</div>

@section Scripts {
    <script>
        // DELETE LOGIC
        async function confirmDelete(reviewId) {
            const confirmed = await globalPopup.confirm({
                title: 'Delete Review',
                message: 'Are you sure you want to delete this review? This action cannot be undone.',
                confirmText: 'Delete',
                cancelText: 'Cancel',
                danger: true
            });

            if (confirmed) {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    
                    // Create form data with anti-forgery token
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', token);
                    formData.append('ReviewId', parseInt(reviewId));

                    const response = await fetch('/Dashboard/DeleteReview', {
                        method: 'POST',
                        credentials: 'same-origin',
                        body: formData
                    });

                    if (!response.ok) {
                        const errorText = await response.text();
                        throw new Error('Network error: ' + response.status + ' - ' + errorText);
                    }

                    const data = await response.json();

                    if (data.success) {
                        await globalPopup.alert({
                            title: 'Success',
                            message: 'Review deleted successfully!',
                            icon: 'fa-check-circle',
                            iconType: 'success'
                        });
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        await globalPopup.alert({
                            title: 'Error',
                            message: data.message || 'Failed to delete review.',
                            icon: 'fa-exclamation-circle',
                            iconType: 'danger'
                        });
                    }
                } catch (error) {
                    console.error('Delete error:', error);
                    await globalPopup.alert({
                        title: 'Error',
                        message: 'Error processing request: ' + error.message,
                        icon: 'fa-exclamation-circle',
                        iconType: 'danger'
                    });
                }
            }
        }

        // EDIT LOGIC
        const editModal = document.getElementById('editReviewModal');

        function openEditModal(id, rating, comment) {
            document.getElementById('editReviewId').value = id;
            document.getElementById('editRating').value = rating;
            document.getElementById('editComment').value = comment;
            editModal.classList.add('active');
        }

        function closeEditModal() {
            editModal.classList.remove('active');
        }

        async function submitEditReview(e) {
            e.preventDefault();
            const id = document.getElementById('editReviewId').value;
            const rating = document.getElementById('editRating').value;
            const comment = document.getElementById('editComment').value;
            
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

            try {
                const response = await fetch(`/Review/Edit/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Rating: parseInt(rating), Comment: comment })
                });
                const data = await response.json();
                
                if (data.success) {
                    location.reload();
                } else {
                    await globalPopup.alert({
                        title: 'Error',
                        message: data.message,
                        icon: 'fa-exclamation-circle',
                        iconType: 'danger'
                    });
                    btn.disabled = false;
                    btn.innerHTML = 'Update Review';
                }
            } catch (error) {
                await globalPopup.alert({
                    title: 'Error',
                    message: 'Error updating review',
                    icon: 'fa-exclamation-circle',
                    iconType: 'danger'
                });
                btn.disabled = false;
                btn.innerHTML = 'Update Review';
            }
        }

        // Close on outside click
        window.addEventListener('click', function(e) {
            if (e.target === editModal) closeEditModal();
        });
    </script>
}
