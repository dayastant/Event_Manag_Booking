@model Event_Management_System.Models.Member
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Settings";
}

<link rel="stylesheet" href="~/css/dashboard-premium.css" />

<div>
    <h1 style="margin-bottom: 30px; font-weight: 700; color: #0b1b3a;">Account Settings</h1>
    
    <div class="grid-2">
        <!-- Profile Settings -->
        <div class="dashboard-premium-card dashboard-animated">
            <h3>Profile Details</h3>
            
            <form id="settings-form" asp-action="UpdateProfile" asp-controller="Dashboard" method="post">
                
                <!-- Hidden field for categories -->
                <input type="hidden" id="preferredCategoriesHidden" name="PreferredCategory" value="@Model.PreferredCategory" />
                
                <!-- Profile Picture Upload -->
                <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 25px;">
                    <div style="position: relative;">
                        @{
                            var profilePhoto = Model.ProfilePhotoBase64 ?? "/images/prf.png";
                        }
                        <img src="@profilePhoto" id="profilePreview" alt="Profile" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid #0b1b3a;">
                        <label for="profileUpload" style="position: absolute; bottom: 0; right: 0; background: linear-gradient(135deg, #0b1b3a 0%, #1e293b 100%); color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(11,27,58,0.3);">
                            <i class="fas fa-camera" style="font-size: 14px;"></i>
                        </label>
                        <input type="file" id="profileUpload" accept="image/*" style="display: none;" onchange="uploadProfilePhoto(this)">
                    </div>
                    <div>
                        <h4 style="margin: 0; font-size: 1.25rem; font-weight: 600; color: #0b1b3a;">@Model.FirstName @Model.LastName</h4>
                        <p class="text-secondary" style="margin: 0; font-size: 0.9rem;">@Model.Email</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">First Name</label>
                            <input asp-for="FirstName" type="text" class="premium-form-input">
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Last Name</label>
                            <input asp-for="LastName" type="text" class="premium-form-input">
                        </div>
                    </div>
                </div>
                
                <div class="premium-form-group">
                    <label class="premium-form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" class="premium-form-input" placeholder="+1 234...">
                </div>
                
                <!-- Multi-Choice Category Selector -->
                <div class="category-selector">
                    <label class="premium-form-label">Preferred Categories</label>
                    <p style="font-size: 0.875rem; color: #64748b; margin-bottom: 0.75rem;">Select one or more categories you're interested in</p>
                    <div class="category-chips">
                        <div class="category-chip" data-category="Music" onclick="toggleCategory(this)">
                            <i class="fas fa-music"></i> Music
                        </div>
                        <div class="category-chip" data-category="Theater" onclick="toggleCategory(this)">
                            <i class="fas fa-theater-masks"></i> Theater
                        </div>
                        <div class="category-chip" data-category="Exhibition" onclick="toggleCategory(this)">
                            <i class="fas fa-palette"></i> Exhibition
                        </div>
                        <div class="category-chip" data-category="Workshop" onclick="toggleCategory(this)">
                            <i class="fas fa-tools"></i> Workshop
                        </div>
                        <div class="category-chip" data-category="Sports" onclick="toggleCategory(this)">
                            <i class="fas fa-basketball-ball"></i> Sports
                        </div>
                        <div class="category-chip" data-category="Film" onclick="toggleCategory(this)">
                            <i class="fas fa-film"></i> Film
                        </div>
                        <div class="category-chip" data-category="Comedy" onclick="toggleCategory(this)">
                            <i class="fas fa-laugh"></i> Comedy
                        </div>
                    </div>
                </div>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn-premium-dashboard">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>
                <div id="message-container" style="margin-top: 15px; display: none;" class="alert"></div>
                @Html.AntiForgeryToken()
            </form>
        </div>

        <!-- Security Settings -->
        <div class="dashboard-premium-card dashboard-animated" style="animation-delay: 0.1s;">
            <h3>Security</h3>
            <p class="text-secondary" style="font-size: 0.9rem; margin-bottom: 20px;">Update your password to keep your account secure.</p>
            
            <form id="password-form" onsubmit="changePassword(event)">
                <div class="premium-form-group">
                    <label class="premium-form-label">Current Password</label>
                    <input type="password" id="currentPassword" class="premium-form-input" required>
                </div>
                
                <div class="premium-form-group">
                    <label class="premium-form-label">New Password</label>
                    <input type="password" id="newPassword" class="premium-form-input" required minlength="8">
                    <small class="text-muted" style="display: block; margin-top: 5px; font-size: 0.8rem;">
                        Min 8 chars, uppercase, lowercase, number & special char.
                    </small>
                </div>
                
                <div class="premium-form-group">
                    <label class="premium-form-label">Confirm New Password</label>
                    <input type="password" id="confirmPassword" class="premium-form-input" required>
                </div>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn-premium-dashboard">
                        <i class="fas fa-key"></i> Update Password
                    </button>
                </div>
                <div id="password-message" style="margin-top: 15px; display: none;" class="alert"></div>
            </form>
        </div>
    </div>
</div>

<script>
    // Initialize selected categories from model
    document.addEventListener('DOMContentLoaded', function() {
        const existingCategories = '@Model.PreferredCategory';
        if (existingCategories) {
            const categories = existingCategories.split(',').map(c => c.trim());
            categories.forEach(category => {
                const chip = document.querySelector(`.category-chip[data-category="${category}"]`);
                if (chip) {
                    chip.classList.add('selected');
                }
            });
        }
    });

    // Category Toggle Function
    function toggleCategory(chip) {
        chip.classList.toggle('selected');
        updateCategoriesInput();
    }

    function updateCategoriesInput() {
        const selected = Array.from(document.querySelectorAll('.category-chip.selected'))
            .map(chip => chip.dataset.category);
        document.getElementById('preferredCategoriesHidden').value = selected.join(', ');
    }

    // Profile Update - WITH TOAST SUPPRESSION FOR SETTINGS PAGE
    document.getElementById('settings-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = this.querySelector('button[type="submit"]');
        const msg = document.getElementById('message-container');
        
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        msg.style.display = 'none';
        
        try {
            const formData = new FormData(this);
            const response = await fetch('@Url.Action("UpdateProfile", "Dashboard")', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                throw new Error('Network response was not ok: ' + response.statusText);
            }

            const data = await response.json();
            
            msg.style.display = 'block';
            msg.className = data.success ? 'alert alert-success' : 'alert alert-error';
            msg.innerText = data.message;
            
            // Suppress toast notifications on settings page
            if (typeof window.suppressToast !== 'undefined') {
                window.suppressToast = true;
            }
            
            if (data.success) {
                location.reload(); 
            }
        } catch (error) {
            console.error('Profile update error:', error);
            msg.style.display = 'block';
            msg.className = 'alert alert-error';
            msg.innerText = 'An error occurred. Please try again.';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save"></i> Save Changes';
        }
    });

    // Profile Photo Upload
    async function uploadProfilePhoto(input) {
        if (!input.files || !input.files[0]) return;
        
        const formData = new FormData();
        formData.append('profilePhoto', input.files[0]);
        
        // Show loading state on preview
        const originalSrc = document.getElementById('profilePreview').src;
        document.getElementById('profilePreview').style.opacity = '0.5';
        
        try {
            const response = await fetch('@Url.Action("UploadProfilePhoto", "Dashboard")', {
                method: 'POST',
                body: formData
            });
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('profilePreview').src = data.imageUrl;
                // Update all instances of profile avatar on the page
                document.querySelectorAll('.dashboard-user-avatar, .profile-avatar').forEach(img => {
                    img.src = data.imageUrl;
                });
                
                // Show success using global popup instead of alert
                if (typeof globalPopup !== 'undefined') {
                    globalPopup.alert({
                        title: 'Success',
                        message: 'Profile photo updated successfully!',
                        icon: 'fa-check-circle',
                        iconType: 'info'
                    });
                }
            } else {
                if (typeof globalPopup !== 'undefined') {
                    globalPopup.alert({
                        title: 'Error',
                        message: data.message,
                        icon: 'fa-exclamation-circle',
                        iconType: 'danger'
                    });
                } else {
                    alert(data.message);
                }
                document.getElementById('profilePreview').src = originalSrc;
            }
        } catch (error) {
            if (typeof globalPopup !== 'undefined') {
                globalPopup.alert({
                    title: 'Error',
                    message: 'Error updating photo',
                    icon: 'fa-exclamation-circle',
                    iconType: 'danger'
                });
            } else {
                alert('Error updating photo');
            }
        } finally {
            document.getElementById('profilePreview').style.opacity = '1';
        }
    }

    // Change Password
    async function changePassword(e) {
        e.preventDefault();
        const btn = e.target.querySelector('button[type="submit"]');
        const msg = document.getElementById('password-message');
        
        const currentPassword = document.getElementById('currentPassword').value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        
        if (newPassword !== confirmPassword) {
            msg.style.display = 'block';
            msg.className = 'alert alert-error';
            msg.innerText = 'New passwords do not match';
            return;
        }
        
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
        msg.style.display = 'none';
        
        try {
            const response = await fetch('@Url.Action("ChangePassword", "Dashboard")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    currentPassword: currentPassword,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                })
            });
            const data = await response.json();
            
            msg.style.display = 'block';
            msg.className = data.success ? 'alert alert-success' : 'alert alert-error';
            msg.innerText = data.message;
            
            if (data.success) {
                e.target.reset();
            }
        } catch (error) {
            msg.style.display = 'block';
            msg.className = 'alert alert-error';
            msg.innerText = 'An error occurred.';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-key"></i> Update Password';
        }
    }

    // SUPPRESS GLOBAL TOAST
    document.addEventListener('DOMContentLoaded', function() {
        const globalToasts = document.querySelectorAll('.toast-container, .toast, .alert-success-fixed, .alert-danger-fixed');
        globalToasts.forEach(t => {
            t.style.display = 'none';
            t.innerHTML = '';
        });
        
        // Also clear TempData related elements if they exist
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(a => {
            if (!a.closest('form')) { // Don't hide form validation alerts inside the form interacting right now
                a.style.display = 'none'; 
            }
        });
    });
</script>

