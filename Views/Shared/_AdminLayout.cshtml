<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CulturaPass Admin</title>
    <link rel="stylesheet" href="~/css/admin.css">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <img src="~/images/logo.png" alt="CulturaPass" style="width: 40px; height: 40px; object-fit: contain;">
                    <span>CulturaPass</span>
                </div>

            </div>

            <nav class="sidebar-nav">
                <a href="@Url.Action("Index", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>
                <a href="@Url.Action("Events", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Events" || ViewContext.RouteData.Values["action"]?.ToString() == "CreateEvent" || ViewContext.RouteData.Values["action"]?.ToString() == "EditEvent" ? "active" : "")">
                    <i class="fas fa-calendar-alt"></i>
                    <span>Events</span>
                </a>
                <a href="@Url.Action("Users", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" || ViewContext.RouteData.Values["action"]?.ToString() == "EditUser" ? "active" : "")">
                    <i class="fas fa-users"></i>
                    <span>Users</span>
                </a>
                <a href="@Url.Action("Reviews", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Reviews" || ViewContext.RouteData.Values["action"]?.ToString() == "EditReview" ? "active" : "")">
                    <i class="fas fa-star"></i>
                    <span>Reviews</span>
                </a>
                <a href="@Url.Action("Venues", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Venues" || ViewContext.RouteData.Values["action"]?.ToString() == "CreateVenue" || ViewContext.RouteData.Values["action"]?.ToString() == "EditVenue" ? "active" : "")">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>Venues</span>
                </a>
                <a href="@Url.Action("Inquiries", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Inquiries" ? "active" : "")">
                    <i class="fas fa-envelope-open-text"></i>
                    <span>Inquiries</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="admin-info">
                    <i class="fas fa-user-shield"></i>
                    <span>@Context.Session.GetString("AdminName")</span>
                </div>
                <a href="@Url.Action("Logout", "Admin")" class="btn-logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="admin-main">
            <header class="admin-header">
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
                <div class="header-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn-view-site" target="_blank">
                        <i class="fas fa-external-link-alt"></i>
                        View Website
                    </a>
                </div>
            </header>

            <main class="admin-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i>
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-circle"></i>
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        // Sidebar toggle for mobile
        document.getElementById('sidebarToggle')?.addEventListener('click', function() {
            document.getElementById('adminSidebar').classList.toggle('active');
        });

        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            document.querySelectorAll('.alert').forEach(function(alert) {
                alert.style.opacity = '0';
                setTimeout(function() {
                    alert.remove();
                }, 300);
            });
        }, 5000);

        // Delete Modal Logic
        let actionUrlToDelete = '';
        
        function showDeleteModal(url) {
            actionUrlToDelete = url;
            document.getElementById('deleteModal').classList.add('active');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
        }

        function confirmDelete() {
            if (actionUrlToDelete) {
                // Create a form and submit it
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = actionUrlToDelete;
                
                // Add AntiForgeryToken
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token;
                form.appendChild(tokenInput);

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
    
    <!-- Global AntiForgeryToken for AJAX/JS forms -->
    <div style="display:none">
        @Html.AntiForgeryToken()
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-box">
            <div class="modal-icon text-danger">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h3 class="modal-title">Confirm Deletion</h3>
            <p class="modal-text">Are you sure you want to delete this item? This action cannot be undone and may remove related data.</p>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
                <button type="button" class="btn-confirm-delete" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
